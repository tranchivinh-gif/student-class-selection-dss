{
    "experiment": "16 - Outlier Treatment",
    "random_seed": 42,
    "n_splits": 5,
    "cv_source": "data/data-splits/cv_folds_v1",
    "n_development": 9000,
    "n_features": 96,
    "n_labels": 9,
    "models": [
        "Random Forest",
        "XGBoost",
        "CatBoost"
    ],
    "treatments": {
        "raw": {
            "method": "None"
        },
        "iqr_capping": {
            "method": "IQR",
            "factor": 1.5
        },
        "quantile_capping": {
            "method": "Quantile",
            "lower": 0.01,
            "upper": 0.99
        }
    },
    "fit_thresholds_on": "Training fold only",
    "validation_uses_training_thresholds": true,
    "students_removed": 0,
    "target_modified": false,
    "prediction_strategy": "Top-4",
    "class_weight_enabled": false,
    "oversampling_enabled": false,
    "feature_engineering_enabled": false,
    "v1_hyperparameters": {
        "Random Forest": {
            "n_estimators": 200,
            "criterion": "gini",
            "max_depth": null,
            "min_samples_split": 2,
            "min_samples_leaf": 1,
            "max_features": "sqrt",
            "bootstrap": true,
            "class_weight": null,
            "random_state": 42,
            "n_jobs": -1
        },
        "XGBoost": {
            "n_estimators": 200,
            "max_depth": 6,
            "learning_rate": 0.1,
            "subsample": 1.0,
            "colsample_bytree": 1.0,
            "objective": "binary:logistic",
            "eval_metric": "logloss",
            "random_state": 42,
            "n_jobs": -1,
            "tree_method": "hist"
        },
        "CatBoost": {
            "iterations": 500,
            "depth": 6,
            "learning_rate": 0.05,
            "loss_function": "Logloss",
            "l2_leaf_reg": 3.0,
            "random_seed": 42,
            "thread_count": -1,
            "verbose": false,
            "allow_writing_files": false
        }
    },
    "raw_reproduction_pass": true,
    "independent_test_used": false
}